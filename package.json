{
  "name": "projectdeck",
  "version": "0.1.0",
  "description": "Local project catalog and control deck for your AI-built projects",
  "type": "module",
  "license": "MIT",
  "bin": {
    "projectdeck": "bin/projectdeck.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/server/main.ts --no-open\" \"vite\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup src/server/main.ts --format esm --target node20 --out-dir dist/server --clean",
    "start": "node bin/projectdeck.mjs",
    "test": "node --import tsx --test --test-timeout=90000 test/unit/*.test.ts test/integration/*.test.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --import tsx --test --test-timeout=120000 test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "ansi-to-html": "^0.7.2",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.81.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
